# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL) — o'zingizning URL ni qo'ying
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"

# JWT — kuchli, tasodifiy kalitlar ishlating
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Click.uz — startupda o'chirilgan, bo'sh qoldiring
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payme.uz — startupda o'chirilgan, bo'sh qoldiring
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Fayl yuklash
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=200
# local | s3  (production uchun s3 tavsiya)
UPLOAD_PROVIDER=local

# S3 (UPLOAD_PROVIDER=s3 bo'lsa)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Email (ixtiyoriy — bo'sh qoldirilsa konsolga yoziladi)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
